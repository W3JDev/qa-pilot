# qa-pilot HTTP server — Railway-deployable image.
#
# Differs from the CLI Dockerfile in that the entrypoint runs the FastAPI
# server instead of the CLI. Listens on $PORT (Railway sets this).

FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Playwright Chromium runtime deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 \
    libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 libxext6 \
    libxfixes3 libxrandr2 libgbm1 libpango-1.0-0 libcairo2 \
    libasound2 libatspi2.0-0 fonts-liberation \
    ca-certificates wget curl xdg-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work

COPY pyproject.toml README.md /work/
COPY src /work/src
RUN pip install --no-cache-dir .[server]

# Install Playwright Chromium (headless build).
# System libraries (libnss3, libatk1.0-0, libxcomposite1, ...) are already
# installed manually in step 2 above, so we omit --with-deps. Older
# Playwright accepted --with-deps=false; current versions don't.
RUN python -m playwright install chromium

# Default Railway sets $PORT; we honor it. Health check at /health.
EXPOSE 8000
CMD ["sh", "-c", "uvicorn qa_pilot.server:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers"]
